  state = { score: 0, combo: 1, best: 0 }; cn = 0;
  wrapRef = React.createRef(); canvasRef = React.createRef();
  Wt = 500; Lt = 800; RB = 16; RP = 60; PY = 690; RS = 0;
  ax = 250; avx = 0; aoff = 0; aerr = 0; aring = 0;
  ball = null; trail = []; serveIn = 0.3; coins = []; texts = []; parts = []; spawnIn = 0.5; px = 250; tx = 250; pvx = 0; keys = {}; actx = null; lastTick = 0; stageFlash = 1.6; ring = 0;
  componentDidMount() {
    try { this.setState({ best: +localStorage.getItem('ah-best') || 0 }); } catch (e) {}
    const cv = this.canvasRef.current, wrap = this.wrapRef.current;
    this.ctx = cv.getContext('2d'); this.W = 0; this.H = 0; this.dpr = 1;
    this.resize = () => {
      const r = wrap.getBoundingClientRect(); this.dpr = Math.min(window.devicePixelRatio || 1, 2); this.W = r.width; this.H = r.height; cv.width = r.width * this.dpr; cv.height = r.height * this.dpr;
      this.s = Math.max(0.3, Math.min(1.1, Math.min(r.width / 640, r.height / 360))); this.Wt = r.width / this.s; this.Lt = r.height / this.s; this.PY = this.Lt - 50; this.PW = r.width; this.PH = r.height;
      this.px = Math.min(this.px, this.Wt - 60); this.tx = this.px;
    };
    this.ro = new ResizeObserver(this.resize); this.ro.observe(wrap); this.resize();
    const setX = e => { const r = cv.getBoundingClientRect(); this.tx = (e.clientX - r.left) / this.s; };
    cv.addEventListener('pointerdown', e => { setX(e); cv.setPointerCapture(e.pointerId); wrap.focus({ preventScroll: true }); });
    cv.addEventListener('pointermove', setX);
    this.onKey = e => { const k = e.key; const m = { ArrowLeft: 'ArrowLeft', ArrowUp: 'ArrowLeft', a: 'ArrowLeft', w: 'ArrowLeft', ArrowRight: 'ArrowRight', ArrowDown: 'ArrowRight', d: 'ArrowRight', s: 'ArrowRight' }[k]; if (m) { e.preventDefault(); this.keys[m] = e.type === 'keydown'; } };
    wrap.addEventListener('keydown', this.onKey); wrap.addEventListener('keyup', this.onKey);
    this.last = performance.now();
    const loop = t => { this.raf = requestAnimationFrame(loop); const dt = Math.min((t - this.last) / 1000, 0.033); this.last = t; this.step(dt); this.draw(); };
    this.raf = requestAnimationFrame(loop);
  }
  componentWillUnmount() { cancelAnimationFrame(this.raf); this.ro && this.ro.disconnect(); }
  stage() { return 1 + Math.floor(this.state.score / 10); }
  base() { return 480; }
  serve() { const a = (Math.random() - 0.5) * 1.2, v = this.base() * 0.8; this.ball = { x: 80 + Math.random() * Math.max(40, this.Wt - 160), y: 110, vx: Math.sin(a) * v, vy: Math.cos(a) * v }; this.trail = []; }
  step(dt) {
    const W = this.Wt, RB = this.RB, RP = this.RP;
