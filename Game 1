  }
  renderVals() { return { wrapRef: this.wrapRef, canvasRef: this.canvasRef }; }
}

const game = new Component();
game.wrapRef.current = document.getElementById('game');
game.canvasRef.current = document.getElementById('cv');
game.componentDidMount();
</script>
</body>
</html>
