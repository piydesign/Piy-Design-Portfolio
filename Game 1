    this.tx = Math.max(RP, Math.min(W - RP, this.tx));
    const dx = Math.max(-2800 * dt, Math.min(2800 * dt, this.tx - this.px)); this.px += dx; this.pvx = dx / Math.max(dt, 0.001);
