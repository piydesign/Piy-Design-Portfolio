<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Air Hockey Coins</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&display=swap" rel="stylesheet">
<style>
html,body{margin:0;height:100%;overflow:hidden;background:#0F1115}
#stage{width:100%;height:100dvh;container-type:size;display:flex;align-items:center;justify-content:center;background:#0F1115}
#game{position:relative;width:min(100cqw,200cqh);aspect-ratio:2/1;background:#14171C;border-radius:20px;box-shadow:inset 0 0 0 1px #262B33;overflow:hidden;outline:none;touch-action:none;user-select:none;-webkit-user-select:none}
#game canvas{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:ew-resize;border-radius:20px}
#game i{position:absolute;inset:0;border-radius:20px;box-shadow:inset 0 0 0 1px #262B33;pointer-events:none}
</style>
</head>
<body>
<div id="stage">
  <div id="game" tabindex="0" aria-label="Air hockey coin game. Slide the bar left and right to hit the ball into coins. Arrow keys move the bar.">
    <canvas id="cv"></canvas><i></i>
  </div>
</div>
<script>
const React = { createRef: () => ({ current: null }) };
class DCLogic {
  setState(o) { Object.assign(this.state, typeof o === 'function' ? o(this.state) : o); }
}
